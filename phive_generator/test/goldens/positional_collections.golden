    writer.write(serializeMetadataHeader(metadata_header));
    writer.write(obj.items);
    writer.write(obj.scores);
    writer.write(obj.groups);
    writer.write(ctx_hooked.value);
    runPostWrite(const [CollectionStubHook()], ctx_hooked);
